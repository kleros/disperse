# Copy to .env.local and fill in. VITE_* values are inlined into the client bundle
# at build time: set them in the build environment (e.g. Netlify) and never put secrets in them.

# WalletConnect project ID (https://dashboard.walletconnect.com). Recommended in production:
# without it the WalletConnect connector (mobile wallets via QR) doesn't work; injected wallets still do.
VITE_WC_PROJECT_ID=

# Endpoint listing University Court connections, used by the "add university court users" section.
# Default: /api/listConnections, proxied to the Court's Netlify function by the Vite dev server
# (vite.config.ts) and by public/_redirects on Netlify. Set a full URL only if hosting elsewhere;
# the endpoint must then allow CORS from this app's origin.
# VITE_CONNECTIONS_URL=https://example.com/api/listConnections

# Only for `pnpm exec wagmi generate` (regenerates src/generated.ts), not read by the app.
# ETHERSCAN_API_KEY=
